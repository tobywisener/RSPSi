    "tieredFlooring": false,
    "footprints": {
      "allowedShapes": ["RECT"],
      "rectWeight": 1,
      "lWeight": 0,
      "uWeight": 0,
      "minWingWidth": 3,
      "minWingDepth": 3,
      "minCourtyardWidth": 3,
      "minCourtyardDepth": 3
    },
    "groundFloor": {
      "overlayShape": 1,
      "tileFlag": 4
    },
    "village": {
      "path": {
        "overlayShape": 1
      },
      "centrepiece": {
        "overlayShape": 1
      }
    }
  }
